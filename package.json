{
  "name": "tokenizer-training",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "playtest:serve": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "playtest:serve:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "playtest:links": "tsx scripts/print-playtest-links.ts",
    "playtest:qa-links": "tsx scripts/print-playtest-qa-links.ts",
    "playtest:notes": "tsx scripts/prepare-playtest-notes.ts",
    "playtest:rollup": "tsx scripts/prepare-playtest-rollup.ts",
    "playtest:status": "tsx scripts/report-playtest-status.ts",
    "playtest:brief": "tsx scripts/report-playtest-brief.ts",
    "playtest:doctor": "tsx scripts/check-playtest-server.ts",
    "playtest:launch-check": "tsx scripts/check-playtest-launch.ts",
    "playtest:preflight": "npm run generate:fixtures && npm run test && npm run build && npm run playtest:audit:local",
    "playtest:audit:local": "tsx scripts/audit-playtest-readiness.ts --local",
    "playtest:audit": "tsx scripts/audit-playtest-readiness.ts",
    "playtest:evaluate": "tsx scripts/evaluate-playtest-notes.ts",
    "playtest:evaluate-rollup": "tsx scripts/evaluate-playtest-rollup.ts",
    "mobile:preflight": "npm run generate:fixtures && npm run test && npm run build && npm run build:ios-web && npm run mobile:crossref",
    "mobile:completion": "tsx scripts/evaluate-mobile-completion.ts",
    "mobile:local": "npm run mobile:crossref && npm run mobile:simulator && npm run mobile:freshness",
    "mobile:capture": "tsx scripts/capture-mobile-cross-reference.ts",
    "mobile:crossref": "tsx scripts/evaluate-mobile-cross-reference.ts",
    "mobile:crossref:status": "tsx scripts/report-mobile-cross-reference-autonomy.ts",
    "mobile:freshness": "tsx scripts/evaluate-mobile-evidence-freshness.ts",
    "mobile:simulator": "tsx scripts/evaluate-ios-simulator-evidence.ts",
    "mobile:surface": "tsx scripts/evaluate-mobile-surface-evidence.ts",
    "mobile:runtime": "tsx scripts/evaluate-mobile-runtime-evidence.ts",
    "mobile:prepare": "tsx scripts/prepare-mobile-device-validation.ts",
    "mobile:desktop-evidence": "tsx scripts/seed-mobile-desktop-harness-evidence.ts",
    "mobile:physical": "tsx scripts/report-mobile-physical-readiness.ts",
    "mobile:device-probe": "tsx scripts/probe-mobile-device-access.ts",
    "mobile:status": "tsx scripts/report-mobile-status.ts",
    "mobile:validate": "tsx scripts/evaluate-mobile-device-validation.ts",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base /tokenizer-training/",
    "build:ios-web": "tsc --noEmit && vite build --base ./ --outDir ios/TokenizerTraining/WebAssets --emptyOutDir",
    "test": "vitest run",
    "generate:fixtures": "tsx scripts/generate-token-fixtures.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "js-tiktoken": "^1.0.21",
    "playwright": "^1.61.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.13"
  }
}
